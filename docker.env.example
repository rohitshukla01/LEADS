# Settings for the Docker version of LEADS. Copy this file to .env and add your key.
# Never commit .env.

# Your own API key for the language model. By default it is an OpenAI key with access to gpt-4.1
# and gpt-4.1-mini. Without a key LEADS still shows the data, the rule check and the forecast, but
# no written answer.
OPENAI_API_KEY=

# Optional: another provider with an OpenAI-compatible chat API. Put that provider's key in
# OPENAI_API_KEY above and remove the "# " in front of that provider's three lines below.
#
# Google Gemini:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-3.5-flash-lite
# LEADS_AUX_MODEL=gemini-3.5-flash-lite
#
# Anthropic (Claude):
# OPENAI_BASE_URL=https://api.anthropic.com/v1
# OPENAI_MODEL=claude-sonnet-4-6
# LEADS_AUX_MODEL=claude-haiku-4-5
#
# Another provider, such as your institution's own model service, needs three lines of the same form.
# The address ends with the version path and no slash, as in https://api.openai.com/v1. Choose
# models that do not think at length before answering.

# Literature search goes through a server run by the authors. Delete this line to run without it
# (answers then have no literature evidence).
LEADS_RELAY_URL=https://leads-relay-murex.vercel.app/api
