# LEADS settings. Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any file containing real keys.
# Optional settings are commented out; remove the leading "# " to set one.

# Required
# Language model (writer and claim checker) and literature embeddings
OPENAI_API_KEY=
# Reranking of literature passages (without it, no literature is retrieved; CO_API_KEY also works)
COHERE_API_KEY=
# Vector index holding the literature passages (a local Qdrant works)
QDRANT_URL=
QDRANT_COLLECTION=leads_docs
# Needed for Qdrant Cloud; not needed for a local Qdrant
# QDRANT_API_KEY=

# Required: sign-in, paper list and saved conversations (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; never expose
SUPABASE_SERVICE_ROLE_KEY=

# Optional: use another OpenAI-compatible model provider
# The writer and checker can run on any OpenAI-compatible endpoint; embeddings keep OPENAI_API_KEY.
# LEADS_GEN_BASE_URL=
# LEADS_GEN_API_KEY=
# Writer model (default gpt-4.1) and checker/auxiliary model (default gpt-4.1-mini;
# LEADS_AUX_MODEL applies only when OPENAI_MODEL is set)
# OPENAI_MODEL=
# LEADS_AUX_MODEL=
# OPENAI_BASE_URL=
# LEADS_LLM_TIMEOUT_MS=

# Optional: run without sign-in (the Docker version in the main README)
# Set it before `npm run build`. LEADS then needs no Supabase and asks for no sign-in: use it on your own computer only.
# NEXT_PUBLIC_LEADS_NO_SIGN_IN=1
# Address of a relay that runs the three outside calls of the literature search (question embedding,
# passage search and reranking) and holds their keys; COHERE_API_KEY and QDRANT_* are then not needed
# LEADS_RELAY_URL=

# Optional: answer cache, keyword index and session memory (Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: public data sources (defaults shown)
# LEADS_PUBLIC_VERA_URL=https://amnh1.osn.mghpcc.org/bio230121-bucket01/vera4cast/targets/project_id=vera4cast/duration=P1D/daily-insitu-targets.csv.gz
# LEADS_FLARE_BASE_URL=https://amnh1.osn.mghpcc.org/bio230121-bucket01/flare/forecasts/parquet
# LEADS_FLARE_MODEL_ID=glm_aed_flare_v3
# LEADS_FLARE_SITE=fcre
# LEADS_FLARE_LOOKBACK_DAYS=
# LEADS_OPERATIONAL_SENSOR_URL=
# LEADS_OPERATIONAL_SENSOR_API_KEY=

# Optional: data freshness windows in days
# Defaults: sensors 3/14, FluoroProbe 14/35, lab 14/45, forecast 2/7
# LEADS_FRESH_CONTINUOUS_CURRENT=
# LEADS_FRESH_CONTINUOUS_AGED=
# LEADS_FRESH_FLUOROPROBE_CURRENT=
# LEADS_FRESH_FLUOROPROBE_AGED=
# LEADS_FRESH_LAB_CURRENT=
# LEADS_FRESH_LAB_AGED=
# LEADS_FRESH_FORECAST_CURRENT=
# LEADS_FRESH_FORECAST_AGED=

# Optional: literature corpus ingestion (npm run ingest-corpus reads ../LLM_Papers)
# Apache Tika server for DOCX, PPTX, HTML and similar files
# TIKA_URL=
# Set to 1 to run OCR in Docling for scanned PDFs
# LEADS_DOCLING_OCR=1
# Papers with more chunks than this skip the RAPTOR summaries (default 2000)
# RAPTOR_MAX_CHUNKS=

# Optional: behaviour switches
# off (default): summary nodes left out of search; legacy: searched with passages
# LEADS_RAPTOR_MODE=
# on (default): literature excerpts are verbatim quotations
# LEADS_LIT_VERBATIM=
# on (default): literature citation markers are adjusted to the sources the claim checker matched; off leaves them as written
# LEADS_CITATION_ALIGN=
# How forecasts are given to the model: summary (default), quantiles or json
# LEADS_FORECAST_REPRESENTATION=
# Set to 1 to bypass the answer cache (for example after changing the code or the model)
# LEADS_DISABLE_QUERY_CACHE=1
# Set to 1 to skip rewriting an answer whose conclusion disagrees with the operating-rule check
# LEADS_DISABLE_CONCLUSION_GUARANTEE=1
# Lab sampling season, MM-DD (defaults 04-01 and 11-30)
# LEADS_SAMPLING_SEASON_START=
# LEADS_SAMPLING_SEASON_END=
# Interface features, on by default (set false to turn one off)
# NEXT_PUBLIC_LEADS_SKILL_CARD_ENABLED=
# NEXT_PUBLIC_LEADS_REPORT_ENABLED=
# NEXT_PUBLIC_LEADS_MARKDOWN_ENABLED=
# NEXT_PUBLIC_LEADS_ANSWER_TIDY=
# NEXT_PUBLIC_LEADS_EVAL_REPORT=

# Optional: spending limits per request
# On by default; LEADS_COST_BREAKER=off disables them. Defaults: 150 model calls, 500000 tokens, 3 US dollars
# LEADS_COST_BREAKER=
# LEADS_MAX_CALLS_PER_REQUEST=
# LEADS_MAX_TOKENS_PER_REQUEST=
# LEADS_MAX_USD_PER_REQUEST=

# Optional: reproducible runs (freeze the data state)
# Pin "today" (e.g. 2026-06-29) and the FLARE run (e.g. 2026-06-26)
# LEADS_AS_OF=
# LEADS_FLARE_REFERENCE_DATE=
# LEADS_EVAL_TEMPERATURE=
# LEADS_EVAL_SEED=
